<?xml version="1.0" encoding="utf-8"?>
<!--
  Main overflow menu.

  The upstream fork's entries ("Open Source" -> ALEX5402/NewBlackbox, "Telegram Group"
  -> t.me/newblackboxa) are gone. They pointed users at a different project's repo and
  chat, which is both confusing and wrong: this build is not that project, and its
  support channel is not that group.

  What is left is what the app actually does. Instances and Diagnostics are the two
  screens that were previously buried here and are now the primary destinations, so
  they stay at the top.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
            android:id="@+id/main_instances"
            android:title="@string/nav_instances"
            app:showAsAction="never" />

    <item
            android:id="@+id/main_diagnostics"
            android:title="@string/diag_title"
            app:showAsAction="never" />

    <item
            android:id="@+id/main_gms"
            android:title="@string/gms_manager"
            app:showAsAction="never" />

    <item
            android:id="@+id/main_setting"
            android:title="@string/setting"
            app:showAsAction="never" />

    <item
            android:id="@+id/fake_location"
            android:title="@string/fake_location"
            app:showAsAction="never" />

</menu>
