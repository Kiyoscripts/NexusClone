<?xml version="1.0" encoding="utf-8"?>
<!-- Card surface: raised fill, hairline border, 16dp radius. No elevation shadow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_raised" />
    <corners android:radius="@dimen/radius_card" />
    <stroke
        android:width="@dimen/hairline"
        android:color="@color/hairline" />
</shape>
