<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base theme.

      DayNight rather than Light: the app previously forced a light theme with
      android:forceDarkAllowed=false, so on a device in dark mode it stayed blindingly white
      while every system surface around it went dark. values-night/colors.xml supplies the
      dark surfaces; nothing else has to change.

      The status bar is the darker brand variant rather than the primary, so the toolbar
      reads as a distinct surface instead of bleeding into the system bar.
    -->
    <style name="Theme.NexusClone" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>

        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorSecondaryVariant">@color/primary</item>
        <item name="colorOnSecondary">@color/text_on_brand</item>

        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/primary_text</item>

        <item name="android:statusBarColor" tools:targetApi="l">@color/primary_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="actionMenuTextColor">@color/primary_text</item>

        <!-- The app draws its own surfaces; letting the platform auto-darken them on top of
             the explicit values-night palette produces muddy double-darkened colours. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- Kept as an alias so any stale reference still resolves. -->
    <style name="Theme.BlackBox" parent="Theme.NexusClone" />

    <style name="ToolBarColorStyle" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="actionMenuTextColor">@color/text_on_brand</item>
        <item name="colorControlNormal">@color/text_on_brand</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="WelcomeTheme" parent="Theme.NexusClone">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/splash_background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/splash_background</item>
    </style>

    <!-- Shared text styles live in values/type.xml. Only the empty root is declared here,
         because AAPT resolves a dotted style name as inheritance: "Text.Title" implicitly
         inherits from "Text", and that base must exist or resource linking fails with
         "resource style/Text not found".

         The individual steps (Text.Title, Text.Body, Text.Caption, Text.Label) used to be
         declared in this file as well as in type.xml. aapt2 compile accepts that because it
         compiles each file independently; the resource merger rejects it with "Duplicate
         resources" and fails the build. One declaration, one file. -->
    <style name="Text" />

    <!-- Buttons: the default Material button is a filled indigo slab, which is far too loud
         when a screen has three of them stacked. Outlined is the default here; the primary
         action on a screen opts into Button.Primary. -->
    <style name="Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- ====================================================================
         Redesign component styles.

         These are the styles the rebuilt screens use. They are deliberately
         plain android.widget.* / androidx widgets with a background drawable
         rather than MaterialButton / MaterialCardView, because the app's
         theme parent is still MaterialComponents and mixing M3 widgets into
         an M2 theme produces half-themed controls. The visual language is
         carried by the drawables and the type scale instead.
         ==================================================================== -->

    <!-- Screen title block -->
    <style name="Nc.AppBarTitle" parent="Text.AppBarTitle" />
    <style name="Nc.AppBarSub" parent="Text.AppBarSub" />

    <!-- Section header row -->
    <style name="Nc.SectionHead" parent="Text.SectionHead">
        <item name="android:layout_marginTop">@dimen/section_head_top</item>
    </style>

    <!-- Card container -->
    <style name="Nc.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">@dimen/space_1</item>
        <item name="android:paddingBottom">@dimen/space_1</item>
    </style>

    <!-- One tappable row inside a card -->
    <style name="Nc.ListRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/listrow_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:paddingTop">@dimen/space_3</item>
        <item name="android:paddingBottom">@dimen/space_3</item>
        <item name="android:background">@drawable/bg_ripple_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Square icon tile inside a row -->
    <style name="Nc.IconTile">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_icon_tile</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginEnd">@dimen/space_3</item>
    </style>

    <!-- Pill badge -->
    <style name="Nc.Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">@dimen/space_2</item>
        <item name="android:paddingEnd">@dimen/space_2</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Buttons -->
    <style name="Nc.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Nc.Button.Primary" parent="Nc.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
    </style>

    <style name="Nc.Button.Ghost" parent="Nc.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Nc.Button.Danger" parent="Nc.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- Text input -->
    <style name="Nc.Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_3</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Field label above an input -->
    <style name="Nc.FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Filter chip -->
    <style name="Nc.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_3</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Icon-only button -->
    <style name="Nc.IconButton">
        <item name="android:layout_width">@dimen/iconbtn_size</item>
        <item name="android:layout_height">@dimen/iconbtn_size</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/space_2</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_secondary</item>
    </style>

    <!-- Bottom navigation tab -->
    <style name="Nc.Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Nc.TabIcon">
        <item name="android:layout_width">@dimen/icon_size_lg</item>
        <item name="android:layout_height">@dimen/icon_size_lg</item>
        <item name="android:tint">@color/text_tertiary</item>
    </style>

    <style name="Nc.TabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
