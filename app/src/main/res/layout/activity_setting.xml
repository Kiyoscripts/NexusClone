<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings.

  Three grouped cards: System (rows that push another screen), Behaviour
  (switches that take effect immediately) and About (read-only spec rows).
  Grouping is carried by the section heads and the card borders, not by
  elevation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".view.setting.SettingActivity">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/gutter"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_3">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Nc.IconButton"
            android:src="@drawable/ic_nc_arrow_back"
            android:contentDescription="@string/close" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_2"
            android:orientation="vertical">

            <TextView
                style="@style/Nc.AppBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Nc.AppBarSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/body_bottom_inset">

            <!-- System -->
            <TextView
                style="@style/Nc.SectionHead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System" />

            <LinearLayout
                style="@style/Nc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2">

                <LinearLayout
                    android:id="@+id/rowDiagnostics"
                    style="@style/Nc.ListRow">

                    <FrameLayout style="@style/Nc.IconTile">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_nc_cpu"
                            android:tint="@color/accent"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diag_title" />

                        <TextView
                            android:id="@+id/subDiagnostics"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/badgeDiagnostics"
                        style="@style/Nc.Badge"
                        android:textColor="@color/warn"
                        android:backgroundTint="@color/warn_soft"
                        android:text="2" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:src="@drawable/ic_nc_chevron_right"
                        android:tint="@color/text_tertiary"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowProxy"
                    style="@style/Nc.ListRow">

                    <FrameLayout style="@style/Nc.IconTile">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_nc_globe"
                            android:tint="@color/accent"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Default proxy" />

                        <TextView
                            android:id="@+id/subProxy"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:src="@drawable/ic_nc_chevron_right"
                        android:tint="@color/text_tertiary"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowGms"
                    style="@style/Nc.ListRow">

                    <FrameLayout style="@style/Nc.IconTile">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_nc_shield"
                            android:tint="@color/accent"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gms_manager" />

                        <TextView
                            android:id="@+id/subGms"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:src="@drawable/ic_nc_chevron_right"
                        android:tint="@color/text_tertiary"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- Behaviour -->
            <TextView
                style="@style/Nc.SectionHead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="Behaviour" />

            <LinearLayout
                style="@style/Nc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingTop="@dimen/space_3"
                    android:paddingBottom="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/keepalive_title" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/keepalive_text" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchKeepAlive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_strong"
                        android:trackTint="@color/accent_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingTop="@dimen/space_3"
                    android:paddingBottom="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-start on boot" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Relaunch last running clones" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchBoot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_strong"
                        android:trackTint="@color/accent_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingTop="@dimen/space_3"
                    android:paddingBottom="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Capture previews" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Screenshot each clone on pause" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_strong"
                        android:trackTint="@color/accent_soft" />
                </LinearLayout>
            </LinearLayout>

            <!-- Xposed and hiding. These were preference rows in the old
                 PreferenceFragmentCompat screen; they are the same switches here. -->
            <TextView
                style="@style/Nc.SectionHead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/xp_setting" />

            <LinearLayout
                style="@style/Nc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_4"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingBottom="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_xposed" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchXposed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_strong"
                        android:trackTint="@color/accent_soft" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowXpModules"
                    style="@style/Nc.ListRow">

                    <FrameLayout style="@style/Nc.IconTile">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nc_bolt"
                            android:tint="@color/accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/module_setting" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/jump_module" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nc_chevron_right"
                        android:tint="@color/text_tertiary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_4"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingBottom="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_xposed" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchHideXposed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_strong"
                        android:trackTint="@color/accent_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_4"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingBottom="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_root" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchHideRoot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_strong"
                        android:trackTint="@color/accent_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_4"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingBottom="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daemon_enable" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchDaemon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_strong"
                        android:trackTint="@color/accent_soft" />
                </LinearLayout>
            </LinearLayout>

            <!-- About -->
            <TextView
                style="@style/Nc.SectionHead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="About" />

            <LinearLayout
                style="@style/Nc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:text="Version" />

                    <TextView
                        android:id="@+id/specVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:text="Engine" />

                    <TextView
                        android:id="@+id/specEngine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:text="Device" />

                    <TextView
                        android:id="@+id/specDevice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Hidden toolbar shim: the activity calls setSupportActionBar on this. -->
    

</LinearLayout>
