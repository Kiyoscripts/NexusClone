<?xml version="1.0" encoding="utf-8"?>
<!--
  Diagnostics.

  A score ring card at the top, then the individual checks, then a re-run
  button. The whole body scrolls; the check list is a non-scrolling
  RecyclerView inside the ScrollView so the two do not fight for the gesture.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".view.diagnostics.DiagnosticsActivity">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/gutter"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_3">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Nc.IconButton"
            android:src="@drawable/ic_nc_arrow_back"
            android:contentDescription="@string/close" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_2"
            android:orientation="vertical">

            <TextView
                style="@style/Nc.AppBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diag_title" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Nc.AppBarSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnRerun"
            style="@style/Nc.IconButton"
            android:src="@drawable/ic_nc_refresh"
            android:contentDescription="@string/diag_run" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/body_bottom_inset">

            <!-- Score ring card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_4">

                <FrameLayout
                    android:layout_width="@dimen/ring_size"
                    android:layout_height="@dimen/ring_size">

                    <com.kiyoscripts.nexusclone.widget.ScoreRing
                        android:id="@+id/ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/ringNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:includeFontPadding="false"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/ringDen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_tertiary"
                            android:includeFontPadding="false"
                            android:gravity="center" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_5"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ringTitle"
                        style="@style/Text.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/ringSub"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" />

                    <TextView
                        android:id="@+id/ringMeta"
                        style="@style/Text.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="11sp"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Nc.SectionHead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="Checks" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/btnRunAll"
                style="@style/Nc.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/diag_run"
                android:drawableStart="@drawable/ic_nc_refresh"
                android:drawablePadding="@dimen/space_2"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>

    <!-- Hidden toolbar shim: the activity calls setSupportActionBar on this. -->
    <FrameLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>

</LinearLayout>
