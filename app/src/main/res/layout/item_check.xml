<?xml version="1.0" encoding="utf-8"?>
<!--
  One diagnostics check row.

  A tinted icon tile, title over detail, and a state word on the right. The
  state text colour and the tile tint are set at bind time from the result.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_ripple_row">

    <FrameLayout
        android:id="@+id/checkIcon"
        android:layout_width="@dimen/check_icon"
        android:layout_height="@dimen/check_icon"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/checkGlyph"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_3"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/detail"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.04"
        android:includeFontPadding="false" />

</LinearLayout>
