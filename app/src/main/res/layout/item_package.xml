<?xml version="1.0" encoding="utf-8"?>
<!--
  One installed package row.

  Icon, name over package id, optional clone-count badge, and a clone button.
  The row itself is tappable (opens the app), the trailing button is the
  shortcut for "clone this one".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ripple_row"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/listrow_min_height">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_app_icon" />

        <com.othershe.cornerlabelview.CornerLabelView
            android:id="@+id/cornerLabel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:visibility="invisible"
            app:bg_color="@color/accent_strong"
            app:position="left_top"
            app:side_length="22dp"
            app:text="XP"
            app:text_color="@color/text_on_accent"
            app:text_size="8sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_3"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/packageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_tertiary"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/cloneCount"
        style="@style/Nc.Badge"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btnClone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/space_2"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_nc_plus"
        android:tint="@color/accent"
        android:contentDescription="@string/fab_clone_app" />

</LinearLayout>
