<?xml version="1.0" encoding="utf-8"?>
<!--
  Order matters here, and it is not the obvious order.

  com.github.nukc.stateview.StateView extends android.view.View, not ViewGroup. It
  cannot host children. Instead it inflates its empty/loading/retry views and inserts
  them into the PARENT at its own index (StateView.addToParent -> parent.addView(v,
  parent.indexOfChild(this), lp)).

  The previous layout declared StateView first and the RecyclerView second, both
  match_parent. The RecyclerView therefore painted over the injected empty view, and
  with zero cloned apps the screen was a blank white rectangle with no explanation.

  Declaring the RecyclerView first puts StateView at index 1, so the injected views
  land at index 1 and draw on top of the list. That is the whole fix.

  app:emptyResource replaces the library default (a bare centred TextView reading
  "Empty") with a layout that says what the screen is and what to do next.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            android:scrollbars="vertical" />

    <com.github.nukc.stateview.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:emptyResource="@layout/view_apps_empty" />

</FrameLayout>
